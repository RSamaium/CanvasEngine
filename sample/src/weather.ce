<Canvas backgroundColor="#07111f">
   <Container>
        <Sprite image="./back.png" width={2048} height={2048} />
        <Weather
        effect="rain"
        speed={2}
        windDirection={0.38}
        windStrength={0.44}
        density
        maxDrops={100}
        topDown={true}
        />
   </Container>
</Canvas>

<script>
    import { signal } from 'canvasengine'
  import { Weather } from '@canvasengine/presets'


  const density = signal(1)

  setInterval(() => {
    density.update(n => n + 10)
  }, 1000)
</script>
