<Canvas backgroundColor="#1a472a">
    <Viewport worldWidth={2048} worldHeight={2048} screen clamp={clamp} filters={nightFilters()}>
        <Graphics
            width={800}
            height={600}
            draw={(g) => {
                g.clear();
                g.beginFill(0xffffff);
                g.drawRect(0, 0, 1000, 1000);
                g.endFill();
            }}
        />
        
        <Graphics
            x={playerX}
            y={playerY}
            draw={(g) => {
                g.clear();
                g.beginFill(0xffcc00);
                g.drawCircle(0, 0, 20);
                g.endFill();
            }}
            controls
            viewportFollow={true}
        />
        
        
        </Viewport>
</Canvas>

<script>
    import { createNightFilter } from '@canvasengine/presets'
    import { mount, signal } from 'canvasengine'

    const clamp = {direction: 'all'};
    const nightFilters = signal([]);

    const playerX = signal(400);
    const playerY = signal(300);
    let nightFilter;

    function syncLightToPlayer() {
        if (!nightFilter) return;
        // nightFilter.setLightWorldPosition({
        //     x: playerX(),
        //     y: playerY(),
        // });
    }

    mount((element) => {
        const viewportComponent = element.componentInstance?.children?.find((child) => child?.viewport);
        const viewport = viewportComponent?.viewport;
        if (!viewport) return;

        nightFilter = createNightFilter(viewport, {
            lightWorldPosition: { x: 100, y: 100 },
        });
        nightFilters.set([nightFilter]);
    });

    const controls = signal({
        right: {
            repeat: true,
            bind: "right",
            keyDown() {
                playerX.update((x) => Math.min(x + 10, 2028));
                syncLightToPlayer();
            },
        },
        left: {
            repeat: true,
            bind: "left",
            keyDown() {
                playerX.update((x) => Math.max(x - 10, 20));
                syncLightToPlayer();
            },
        },
        up: {
            repeat: true,
            bind: "up",
            keyDown() {
                playerY.update((y) => Math.max(y - 10, 20));
                syncLightToPlayer();
            },
        },
        down: {
            repeat: true,
            bind: "down",
            keyDown() {
                playerY.update((y) => Math.min(y + 10, 2028));
                syncLightToPlayer();
            },
        },
    })
</script>
