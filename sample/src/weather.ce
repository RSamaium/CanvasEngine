<Canvas backgroundColor="#07111f">
  <Container width="100%" height="100%" sortableChildren={true}>
    <Sprite
      image="./back.png"
      width="100%"
      height="100%"
      objectFit="cover"
      zIndex={0}
    />

    @if (rainActive) {
      <Weather
        effect="rain"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        topDown={weatherTopDown}
        zIndex={10}
      />
    }
    @else if (snowActive) {
      <Weather
        effect="snow"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        zIndex={10}
      />
    }
    @else if (embersActive) {
      <Weather
        effect="embers"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        colors={weatherColors}
        haze={weatherHaze}
        zIndex={10}
      />
    }
    @else if (ashActive) {
      <Weather
        effect="ash"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        colors={weatherColors}
        haze={weatherHaze}
        zIndex={10}
      />
    }
    @else if (leavesActive) {
      <Weather
        effect="leaves"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        colors={weatherColors}
        haze={weatherHaze}
        zIndex={10}
      />
    }
    @else if (petalsActive) {
      <Weather
        effect="petals"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        colors={weatherColors}
        haze={weatherHaze}
        zIndex={10}
      />
    }
    @else if (firefliesActive) {
      <Weather
        effect="fireflies"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        colors={weatherColors}
        haze={weatherHaze}
        zIndex={10}
      />
    }
    @else if (sporesActive) {
      <Weather
        effect="spores"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        colors={weatherColors}
        haze={weatherHaze}
        zIndex={10}
      />
    }
    @else if (sandActive) {
      <Weather
        effect="sand"
        speed={weatherSpeed}
        windDirection={weatherWindDirection}
        windStrength={weatherWindStrength}
        density={weatherDensity}
        maxDrops={weatherMaxDrops}
        colors={weatherColors}
        haze={weatherHaze}
        zIndex={10}
      />
    }
    @else if (raysActive) {
      <Weather
        effect="rays"
        speed={weatherSpeed}
        sunIntensity={weatherSunIntensity}
        sunAngle={weatherSunAngle}
        raySpread={weatherRaySpread}
        rayTwinkle={weatherRayTwinkle}
        rayTwinkleSpeed={weatherRayTwinkleSpeed}
        rayFan={weatherRayFan}
        rayLength={weatherRayLength}
        rayDust={weatherRayDust}
        rayColor={weatherRayColor}
        zIndex={10}
      />
    }
    @else if (fogActive) {
      <Weather
        effect="fog"
        speed={weatherSpeed}
        density={weatherDensity}
        height={weatherHeight}
        scale={weatherScale}
        fogOpacity={weatherFogOpacity}
        fogSoftness={weatherFogSoftness}
        zIndex={10}
      />
    }
    @else {
      <Weather
        effect="cloud"
        speed={weatherSpeed}
        density={weatherDensity}
        height={weatherHeight}
        scale={weatherScale}
        shadowIntensity={weatherShadowIntensity}
        shadowSoftness={weatherShadowSoftness}
        cloudOpacity={weatherCloudOpacity}
        cloudAltitude={weatherCloudAltitude}
        sunIntensity={weatherSunIntensity}
        sunAngle={weatherSunAngle}
        raySpread={weatherRaySpread}
        rayTwinkle={weatherRayTwinkle}
        rayTwinkleSpeed={weatherRayTwinkleSpeed}
        zIndex={10}
      />
    }

    @if (rainActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#071827" alpha={0.2} zIndex={20} />
    }
    @else if (snowActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#183047" alpha={0.16} zIndex={20} />
    }
    @else if (fogActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#0b241f" alpha={0.18} zIndex={20} />
    }
    @else if (cloudActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#422d13" alpha={0.1} zIndex={20} />
    }
    @else if (raysActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#0d1a10" alpha={0.25} zIndex={9} />
    }
    @else if (volcanoActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#2a0a04" alpha={0.28} zIndex={20} />
    }
    @else if (autumnActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#2a1a08" alpha={0.12} zIndex={20} />
    }
    @else if (ambientActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#020a14" alpha={0.5} zIndex={20} />
    }
    @else if (desertActive) {
      <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#3a2a10" alpha={0.1} zIndex={20} />
    }

    <Container
      positionType="absolute"
      top={24}
      left={24}
      width={520}
      height={132}
      display="flex"
      flexDirection="column"
      justifyContent="center"
      padding={[12, 22]}
      gap={4}
      zIndex={30}
    >
      <Rect
        positionType="absolute"
        top={0}
        right={0}
        bottom={0}
        left={0}
        width="100%"
        height="100%"
        color="#07101c"
        alpha={0.88}
        borderRadius={14}
        border={{ width: 1, color: "#52677f" }}
      />
      @if (rainActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#67d4ff" borderRadius={3} />
      }
      @else if (snowActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#d7efff" borderRadius={3} />
      }
      @else if (fogActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#8fe0d1" borderRadius={3} />
      }
      @else if (cloudActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#ffd98b" borderRadius={3} />
      }
      @else if (raysActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#fff1c7" borderRadius={3} />
      }
      @else if (volcanoActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#ff8a4a" borderRadius={3} />
      }
      @else if (autumnActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#ffb45a" borderRadius={3} />
      }
      @else if (ambientActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#c6ff5a" borderRadius={3} />
      }
      @else if (desertActive) {
        <Rect positionType="absolute" top={0} left={0} width={5} height="100%" color="#e3c48f" borderRadius={3} />
      }
      <Text
        width="100%"
        height={14}
        text="WEATHER PRESET LAB"
        color="#8fa7c1"
        size={11}
        fontFamily="Arial"
        style={{ fontWeight: "700", letterSpacing: 1.8 }}
      />
      <Text
        width="100%"
        height={30}
        text={activePresetLabel}
        color="#f8fbff"
        size={25}
        fontFamily="Arial"
        style={{ fontWeight: "700" }}
      />
      <Text
        width="100%"
        height={17}
        text={activeDescription}
        color="#c7d5e5"
        size={13}
        fontFamily="Arial"
      />
      <Text
        width="100%"
        height={14}
        text={activeSettings}
        color={activeAccent}
        size={11}
        fontFamily="monospace"
      />
    </Container>

    <Container
      positionType="absolute"
      right={24}
      bottom={24}
      left={24}
      height={174}
      display="flex"
      flexDirection="column"
      padding={[14, 16]}
      gap={12}
      zIndex={30}
    >
      <Rect
        positionType="absolute"
        top={0}
        right={0}
        bottom={0}
        left={0}
        width="100%"
        height="100%"
        color="#07101c"
        alpha={0.92}
        borderRadius={16}
        border={{ width: 1, color: "#52677f" }}
      />

      <Container width="100%" height={44} display="flex" flexDirection="row" gap={10}>
        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectRain}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#36748e" }} />
          @if (rainActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#164e63" borderRadius={9} />
          }
          <Text text="RAIN · 3" color={rainTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>

        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectSnow}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#7893ad" }} />
          @if (snowActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#344b63" borderRadius={9} />
          }
          <Text text="SNOW · 3" color={snowTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>

        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectFog}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#417e76" }} />
          @if (fogActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#194b45" borderRadius={9} />
          }
          <Text text="FOG · 5" color={fogTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>

        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectCloud}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#8f7440" }} />
          @if (cloudActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#59451f" borderRadius={9} />
          }
          <Text text="CLOUD · 9" color={cloudTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>

        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectRays}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#b5a36a" }} />
          @if (raysActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#5e5528" borderRadius={9} />
          }
          <Text text="RAYS · 6" color={raysTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>

        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectVolcano}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#a8502a" }} />
          @if (volcanoActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#5c2413" borderRadius={9} />
          }
          <Text text="VOLCANO · 3" color={volcanoTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>

        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectAutumn}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#a8742a" }} />
          @if (autumnActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#5c3a13" borderRadius={9} />
          }
          <Text text="SEASONS · 4" color={autumnTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>

        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectAmbient}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#6b8f3a" }} />
          @if (ambientActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#2f4a18" borderRadius={9} />
          }
          <Text text="AMBIENT · 4" color={ambientTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>

        <Container
          height={44}
          flexGrow={1}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={selectDesert}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#111c2b" borderRadius={9} border={{ width: 1, color: "#b0935a" }} />
          @if (desertActive) {
            <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#5e4a24" borderRadius={9} />
          }
          <Text text="DESERT · 2" color={desertTextColor} size={12} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.1 }} />
        </Container>
      </Container>

      <Container width="100%" flexGrow={1} display="flex" flexDirection="row" gap={12} alignItems="stretch">
        <Container
          width={124}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={previousPreset}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#172437" borderRadius={9} border={{ width: 1, color: "#425a73" }} />
          <Text text="‹  PREVIOUS" color="#c6d6e7" size={11} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 0.8 }} />
        </Container>

        <Container flexGrow={1} display="flex" flexDirection="column" justifyContent="center" alignItems="center" gap={5}>
          <Text text={activeCategoryLabel} color={activeAccent} size={11} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.5 }} />
          <Text text={activePresetLabel} color="#f3f7fb" size={18} fontFamily="Arial" style={{ fontWeight: "700" }} />
          <Text text={presetCounter} color="#7890aa" size={10} fontFamily="monospace" />
        </Container>

        <Container
          width={124}
          display="flex"
          justifyContent="center"
          alignItems="center"
          click={nextPreset}
          cursor="pointer"
        >
          <Rect positionType="absolute" top={0} right={0} bottom={0} left={0} width="100%" height="100%" color="#172437" borderRadius={9} border={{ width: 1, color: "#425a73" }} />
          <Text text="NEXT  ›" color="#c6d6e7" size={11} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 0.8 }} />
        </Container>
      </Container>
    </Container>
  </Container>
</Canvas>

<script>
  import { computed, signal } from "canvasengine";
  import {
    AMBIENT_PRESETS,
    AUTUMN_PRESETS,
    CLOUD_PRESETS,
    DESERT_PRESETS,
    RAYS_PRESETS,
    FOG_PRESETS,
    RAIN_PRESETS,
    SNOW_PRESETS,
    VOLCANO_PRESETS,
    Weather,
  } from "@canvasengine/presets";

  const weatherGroups = [
    {
      id: "rain",
      label: "RAIN",
      accent: "#67d4ff",
      presets: [
        { label: "Light Rain", description: "Fine rain with a gentle breeze.", values: RAIN_PRESETS.lightRain },
        { label: "Steady Rain", description: "Balanced rainfall for exploration scenes.", values: RAIN_PRESETS.steadyRain },
        { label: "Storm Rain", description: "Dense, fast rain driven by strong wind.", values: RAIN_PRESETS.stormRain },
      ],
    },
    {
      id: "snow",
      label: "SNOW",
      accent: "#d7efff",
      presets: [
        { label: "Light Snow", description: "Sparse flakes drifting slowly across the map.", values: SNOW_PRESETS.lightSnow },
        { label: "Winter Snow", description: "A calm and continuous winter snowfall.", values: SNOW_PRESETS.winterSnow },
        { label: "Blizzard", description: "Fast, dense snow with powerful lateral wind.", values: SNOW_PRESETS.blizzardSnow },
      ],
    },
    {
      id: "fog",
      label: "FOG",
      accent: "#8fe0d1",
      presets: [
        { label: "Morning Mist", description: "Low, delicate mist for an early RPG morning.", values: FOG_PRESETS.rpgMorningMist },
        { label: "Forest Fog", description: "Layered woodland fog with moderate movement.", values: FOG_PRESETS.rpgForestFog },
        { label: "Swamp Fog", description: "Thick, low fog with a heavy organic feel.", values: FOG_PRESETS.rpgSwampFog },
        { label: "Night Fog", description: "Slow, subdued fog for dark environments.", values: FOG_PRESETS.rpgNightFog },
        { label: "Heavy Fog", description: "Maximum coverage for obscured exploration.", values: FOG_PRESETS.rpgHeavyFog },
      ],
    },
    {
      id: "cloud",
      label: "CLOUDS & SHADOWS",
      accent: "#ffd98b",
      presets: [
        { label: "Light Clouds", description: "Large, soft cloud shadows drifting across the map.", values: CLOUD_PRESETS.lightClouds },
        { label: "Overcast", description: "Broad overlapping shadows for muted daylight.", values: CLOUD_PRESETS.overcastClouds },
        { label: "Storm Clouds", description: "Deep, fast-moving shadows before a storm.", values: CLOUD_PRESETS.stormClouds },
        { label: "Golden Hour", description: "Warm shafts crossing pronounced ground shadows.", values: CLOUD_PRESETS.goldenHourRays },
        { label: "Sunny Soft Rays", description: "Gentle shadows broken by soft sunlight.", values: CLOUD_PRESETS.sunnySoftRays },
        { label: "Sunset Twinkle", description: "Low-angle rays flickering between moving shadows.", values: CLOUD_PRESETS.sunsetTwinkleRays },
        { label: "Crepuscular Rays", description: "Dramatic shafts cutting through dense shadows.", values: CLOUD_PRESETS.dramaticCrepuscularRays },
        { label: "Morning Haze", description: "Faint morning light over slow, soft shadows.", values: CLOUD_PRESETS.morningHazeRays },
        { label: "Natural Clouds", description: "Irregular overhead cloud banks with textured volume and projected shadows.", values: CLOUD_PRESETS.naturalClouds },
      ],
    },
    {
      id: "rays",
      label: "LIGHT RAYS",
      accent: "#fff1c7",
      presets: [
        { label: "Morning Sun", description: "Soft parallel shafts with drifting dust.", values: RAYS_PRESETS.morningSunRays },
        { label: "Golden Hour", description: "Warm low-angle light sweeping the map.", values: RAYS_PRESETS.goldenHourShafts },
        { label: "Forest Shafts", description: "Narrow flickering beams through the canopy.", values: RAYS_PRESETS.forestLightShafts },
        { label: "Moonbeams", description: "Cool, calm night light.", values: RAYS_PRESETS.moonbeams },
        { label: "Holy Rays", description: "A radiant fan of light from above.", values: RAYS_PRESETS.holyRays },
        { label: "Radiant Beams", description: "Intense animated beams for dramatic moments.", values: RAYS_PRESETS.radiantBeams },
      ],
    },
    {
      id: "volcano",
      label: "VOLCANO",
      accent: "#ff8a4a",
      presets: [
        { label: "Volcano Embers", description: "Glowing embers rising and cooling in the hot air.", values: VOLCANO_PRESETS.volcanoEmbers },
        { label: "Eruption", description: "Dense ember storm with a red heat haze.", values: VOLCANO_PRESETS.eruptionEmbers },
        { label: "Ashfall", description: "Grey ash flakes tumbling slowly after an eruption.", values: VOLCANO_PRESETS.ashfall },
      ],
    },
    {
      id: "autumn",
      label: "SEASONS",
      accent: "#ffb45a",
      presets: [
        { label: "Autumn Leaves", description: "Leaves swaying and flipping as they fall.", values: AUTUMN_PRESETS.autumnLeaves },
        { label: "Autumn Gust", description: "A strong wind sweeping leaves across the map.", values: AUTUMN_PRESETS.autumnGust },
        { label: "Sakura Petals", description: "Soft cherry blossom petals drifting in spring.", values: AUTUMN_PRESETS.sakuraPetals },
        { label: "Sakura Storm", description: "A flurry of petals carried by the wind.", values: AUTUMN_PRESETS.sakuraStorm },
      ],
    },
    {
      id: "ambient",
      label: "AMBIENT",
      accent: "#c6ff5a",
      presets: [
        { label: "Summer Fireflies", description: "Fireflies wandering and blinking at night.", values: AMBIENT_PRESETS.summerFireflies },
        { label: "Swamp Fireflies", description: "A dense green swarm over dark water.", values: AMBIENT_PRESETS.swampFireflies },
        { label: "Forest Spores", description: "Luminous spores floating up in a quiet forest.", values: AMBIENT_PRESETS.forestSpores },
        { label: "Enchanted Spores", description: "Pastel magic motes for fairy places.", values: AMBIENT_PRESETS.enchantedSpores },
      ],
    },
    {
      id: "desert",
      label: "DESERT",
      accent: "#e3c48f",
      presets: [
        { label: "Dust Wind", description: "Light sand grains carried along the ground.", values: DESERT_PRESETS.dustWind },
        { label: "Sandstorm", description: "Blinding streaks of sand in a thick haze.", values: DESERT_PRESETS.sandstorm },
      ],
    },
  ];


  const groupIndex = signal(0);
  const presetIndex = signal(1);
  const activeGroup = computed(() => weatherGroups[groupIndex()]);
  const activePreset = computed(() => activeGroup().presets[presetIndex()]);
  const activeValues = computed(() => activePreset().values);

  const weatherSpeed = computed(() => activeValues().speed ?? 0.5);
  const weatherWindDirection = computed(() => activeValues().windDirection ?? 0);
  const weatherWindStrength = computed(() => activeValues().windStrength ?? 0.2);
  const weatherDensity = computed(() => activeValues().density ?? 1);
  const weatherMaxDrops = computed(() => activeValues().maxDrops ?? 80);
  const weatherTopDown = computed(() => activeValues().topDown ?? true);
  const weatherHeight = computed(() => activeValues().height ?? 1);
  const weatherScale = computed(() => activeValues().scale ?? 2);
  const weatherFogOpacity = computed(() => activeValues().fogOpacity ?? 0.38);
  const weatherFogSoftness = computed(() => activeValues().fogSoftness ?? 0.7);
  const weatherShadowIntensity = computed(() => activeValues().shadowIntensity ?? 0.38);
  const weatherShadowSoftness = computed(() => activeValues().shadowSoftness ?? 0.65);
  const weatherCloudOpacity = computed(() => activeValues().cloudOpacity ?? 0);
  const weatherCloudAltitude = computed(() => activeValues().cloudAltitude ?? 0.55);
  const weatherSunIntensity = computed(() => activeValues().sunIntensity ?? 0.85);
  const weatherSunAngle = computed(() => activeValues().sunAngle ?? 0.85);
  const weatherRaySpread = computed(() => activeValues().raySpread ?? 1);
  const weatherRayTwinkle = computed(() => activeValues().rayTwinkle ?? 0.45);
  const weatherRayTwinkleSpeed = computed(() => activeValues().rayTwinkleSpeed ?? 1);
  const weatherColors = computed(() => activeValues().colors);
  const weatherRayFan = computed(() => activeValues().rayFan ?? 0);
  const weatherRayLength = computed(() => activeValues().rayLength ?? 1);
  const weatherRayDust = computed(() => activeValues().rayDust ?? 0.6);
  const weatherRayColor = computed(() => activeValues().rayColor ?? "#fff1c7");
  const weatherHaze = computed(() => activeValues().haze ?? 1);

  const activeAccent = computed(() => activeGroup().accent);
  const activeCategoryLabel = computed(() => activeGroup().label);
  const activePresetLabel = computed(() => activePreset().label);
  const activeDescription = computed(() => activePreset().description);
  const presetCounter = computed(() =>
    `PRESET ${presetIndex() + 1} / ${activeGroup().presets.length}`
  );

  const activeSettings = computed(() => {
    const values = activeValues();
    if (values.effect === "rays") {
      return `LIGHT ${values.sunIntensity.toFixed(2)}  ·  FAN ${values.rayFan.toFixed(2)}  ·  SPREAD ${values.raySpread.toFixed(2)}  ·  TWINKLE ${values.rayTwinkle.toFixed(2)}`;
    }
    if (values.effect !== "fog" && values.effect !== "cloud") {
      return `SPEED ${values.speed.toFixed(2)}  ·  DENSITY ${values.density}  ·  WIND ${values.windStrength.toFixed(2)}  ·  COUNT ${values.maxDrops}`;
    }
    if (values.effect === "fog") {
      return `COVER ${values.density.toFixed(2)}  ·  OPACITY ${values.fogOpacity.toFixed(2)}  ·  SOFT ${values.fogSoftness.toFixed(2)}  ·  SPEED ${values.speed.toFixed(2)}`;
    }
    if ((values.cloudOpacity ?? 0) > 0) {
      return `CLOUD ${values.cloudOpacity.toFixed(2)}  ·  ALTITUDE ${values.cloudAltitude.toFixed(2)}  ·  SHADOW ${values.shadowIntensity.toFixed(2)}  ·  SPEED ${values.speed.toFixed(2)}`;
    }
    return `COVER ${values.density.toFixed(2)}  ·  SHADOW ${values.shadowIntensity.toFixed(2)}  ·  SOFT ${values.shadowSoftness.toFixed(2)}  ·  SPEED ${values.speed.toFixed(2)}`;
  });

  const isGroup = (id) => computed(() => activeGroup().id === id);
  const rainActive = isGroup("rain");
  const snowActive = isGroup("snow");
  const fogActive = isGroup("fog");
  const cloudActive = isGroup("cloud");
  const raysActive = isGroup("rays");
  const volcanoActive = isGroup("volcano");
  const autumnActive = isGroup("autumn");
  const ambientActive = isGroup("ambient");
  const desertActive = isGroup("desert");

  const isEffect = (effect) => computed(() => activeValues().effect === effect);
  const embersActive = isEffect("embers");
  const ashActive = isEffect("ash");
  const leavesActive = isEffect("leaves");
  const petalsActive = isEffect("petals");
  const firefliesActive = isEffect("fireflies");
  const sporesActive = isEffect("spores");
  const sandActive = isEffect("sand");

  const textColor = (active, selected) => computed(() => active() ? selected : "#8da2b8");
  const rainTextColor = textColor(rainActive, "#9ee7ff");
  const snowTextColor = textColor(snowActive, "#e8f6ff");
  const fogTextColor = textColor(fogActive, "#b6f5e7");
  const cloudTextColor = textColor(cloudActive, "#ffe6ad");
  const raysTextColor = textColor(raysActive, "#fff6dc");
  const volcanoTextColor = textColor(volcanoActive, "#ffc2a0");
  const autumnTextColor = textColor(autumnActive, "#ffd9a0");
  const ambientTextColor = textColor(ambientActive, "#e2ffb0");
  const desertTextColor = textColor(desertActive, "#f5e2bd");

  const selectGroup = (index) => {
    if (groupIndex() === index) return;
    groupIndex.set(index);
    presetIndex.set(0);
  };
  const selectRain = () => selectGroup(0);
  const selectSnow = () => selectGroup(1);
  const selectFog = () => selectGroup(2);
  const selectCloud = () => selectGroup(3);
  const selectRays = () => selectGroup(4);
  const selectVolcano = () => selectGroup(5);
  const selectAutumn = () => selectGroup(6);
  const selectAmbient = () => selectGroup(7);
  const selectDesert = () => selectGroup(8);

  const previousPreset = () => {
    const count = activeGroup().presets.length;
    presetIndex.update((index) => (index - 1 + count) % count);
  };

  const nextPreset = () => {
    const count = activeGroup().presets.length;
    presetIndex.update((index) => (index + 1) % count);
  };
</script>
