<Canvas>
  <Viewport worldWidth={2048} worldHeight={2048} clamp={clamp}>
    <Sprite image="back.png" />
    @for (sprite of sprites) {
      <Container  x={sprite.x} y={sprite.y} viewportFollow={true}>
        <Text text={sprite.x} />
        <Sprite image={sprite.image} controls={sprite.controls}   />
      </Container>
    }
</Viewport>
<Container>
  <MenuComponent />
</Container>
</Canvas>

  <script>
    import { signal, animatedSignal, mount, effect, animatedSequence } from "canvasengine";
    import MenuComponent from './focus-navigation-dom.ce'

    const speed = signal(10);
    const acceleration = signal(0.1);
    const radius = signal(100);

    const drag = {
      direction: 'all',
      keyToPress: ['space'],
      pressDrag: false
    }

   const viewportFollow = signal({
    speed,
    //acceleration,
    //radius,
   });
   const clamp = {direction: 'all'};
   const x = signal(0);
   const y = signal(0);
   const controls = signal({
      right: {
        repeat: true,
        bind: "right",
        keyDown() {
          x.update(x => x + 20)
        },
      },
      left: {
        repeat: true,
        bind: "left",
        keyDown() {
          x.update(x => x - 20)
        },
      },
      up: {
        repeat: true,
        bind: "up",
        keyDown() {
          y.update(y => y - 20)
        },
      },
      down: {
        repeat: true,
        bind: "down",
        keyDown() {
          y.update(y => y + 20)
        },
      },
    });

    const snap = signal(50);
    

    const click = () => {
      viewportFollow.set({
        speed: 0.1,
        acceleration: 0.1,
        radius: 100
      })
      console.log('viewport follow', viewportFollow())
    }
  

    const dragStart = () => {
      console.log("drag start")
    }

    const sprites = signal([
      // {
      //   image: "https://pixijs.com/assets/flowerTop.png",
      //   x: signal(0),
      //   y: 400,
      //   controls: signal(false),
      //   viewportFollow: false,  
      // },
      // {
      //   image: "https://pixijs.com/assets/flowerTop.png",
      //   x: signal(0),
      //   y: 500,
      //   controls: signal(false),
      //   viewportFollow: false,  
      // },
      {
        image: "https://pixijs.com/assets/flowerTop.png",
        x,
        y,
        controls,
        viewportFollow,  
        drag,
      },
    ]);
  </script>
