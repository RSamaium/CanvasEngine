<Viewport worldWidth={2048} worldHeight={1536} clamp={clamp}  drag-start={dragStart}>
    <Sprite image="http://localhost:5173/api/uploads/map-upscale.png" />
    @for (sprite of sprites) {
      <Sprite image={@sprite.@image} x={@sprite.x} y={@sprite.@y} controls={@sprite.controls} viewportFollow={@sprite.viewportFollow} click  />
    }
</Viewport>

  <script>
    import { signal, animatedSignal, mount, effect, animatedSequence } from "canvasengine";
   
   const viewportFollow = signal(true);
   const clamp = {direction: 'all'};
   const x = signal(0);
   const controls = signal({
      right: {
        repeat: true,
        bind: "right",
        keyDown() {
          x.update(x => x + 20)
        },
      },
    });

    const snap = signal(50);
    const drag = signal({
      move(event) {
        
      }
    })

    const click = () => {
      viewportFollow.set(false)
      console.log('viewport follow', viewportFollow())
    }
  

    const dragStart = () => {
      console.log("drag start")
    }

    const sprites = signal([
      // {
      //   image: "https://pixijs.com/assets/flowerTop.png",
      //   x: signal(0),
      //   y: 400,
      //   controls: signal(false),
      //   viewportFollow: false,  
      // },
      // {
      //   image: "https://pixijs.com/assets/flowerTop.png",
      //   x: signal(0),
      //   y: 500,
      //   controls: signal(false),
      //   viewportFollow: false,  
      // },
      {
        image: "https://pixijs.com/assets/flowerTop.png",
        x,
        y: 600,
        controls,
        viewportFollow,  
        drag,
      },
    ]);
  </script>