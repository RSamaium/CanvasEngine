<Canvas>
  <Container 
    flexDirection="column" 
    justifyContent="center" 
    alignItems="center" 
    width="100%" 
    height="100%"
  >
    <!-- Component that waits for userData signal -->
    <child dependencies />
  </Container>
</Canvas>

<script>
  import { signal, mount } from 'canvasengine';
  import child from './child.ce';


  // Start with undefined dependencies
  const userData = signal(undefined);
  const config = signal(undefined);
  
  // Create a promise that resolves after a delay
  const assetsPromise = new Promise((resolve) => {
    setTimeout(() => {
      resolve({ sprites: ['sprite1', 'sprite2', 'sprite3'] });
    }, 2000);
  });

  // Loading text that updates based on dependencies
  const loadingText = signal('Loading user data...');

  // Simulate loading user data asynchronously
  setTimeout(() => {
    userData.set({ 
      name: 'Player One', 
      score: 1250, 
      level: 5 
    });
    loadingText.set('Loading config...');
  }, 6000);

  // Simulate loading config
  setTimeout(() => {
    config.set({ theme: 'dark', difficulty: 'hard' });
    loadingText.set('All dependencies loaded!');
  }, 3000);

  // Log when components mount
  mount((element) => {
    console.log('Component mounted:', element.tag);
  });

  const dependencies = [userData];
</script>

