<Canvas backgroundColor="#1b2430">
  <Viewport worldWidth={worldWidth} worldHeight={worldHeight} clamp={clamp} sortableChildren={true}>
    <Sprite image="back.png" />

    <!-- Objet normal: reste visible comme aujourd'hui (atténué par le fog) -->
    <Rect x={relicX} y={relicY} width={34} height={34} color="#ffd166" zIndex={2} />

    <!-- Objet strict: visible seulement dans la zone très claire -->
    <Rect
      x={enemyX}
      y={enemyY}
      width={34}
      height={34}
      color="#5ee7ff"
      zIndex={3}
      fogVisibility={enemyFogVisibility}
    />

    <Graphics
      x={playerX}
      y={playerY}
      zIndex={10}
      draw={(g) => {
        g.clear();
        g.beginFill(0xffcc00);
        g.drawCircle(0, 0, 20);
        g.endFill();
      }}
      controls
      viewportFollow={true}
    />

    <FogOfWar
      mapWidth={worldWidth}
      mapHeight={worldHeight}
      tileSize={tileSize}
      smooth={true}
      renderScale={2}
      edgeSoftness={22}
      visionSources={visionSources}
      controller={fogController}
      updateHz={15}
      colors={fogColors}
      zIndex={1000}
    />
  </Viewport>
</Canvas>

<script>
  import { computed, signal } from 'canvasengine'
  import { FogOfWar, createFogOfWarController } from '@canvasengine/presets'

  const worldWidth = 2048
  const worldHeight = 2048
  const tileSize = 32
  const clamp = { direction: 'all' }

  const playerX = signal(360)
  const playerY = signal(320)
  const allyX = signal(760)
  const allyY = signal(520)
  const enemyX = signal(1080)
  const enemyY = signal(690)
  const relicX = 118
  const relicY = 128

  const fogController = createFogOfWarController()

  const fogColors = {
    unknown: [8, 12, 22, 0.95],
    explored: [0, 0, 0, 0.45],
  }

  const visionSources = computed(() => [
    { x: playerX(), y: playerY(), radius: 240, enabled: true },
    { x: allyX(), y: allyY(), radius: 170, enabled: true },
  ])

  const enemyFogVisibility = {
    controller: fogController,
    mode: 'visible',
    threshold: 0.72,
    point: {
      x: computed(() => enemyX() + 17),
      y: computed(() => enemyY() + 17),
    },
  }

  const controls = signal({
    right: {
      repeat: true,
      bind: 'right',
      keyDown() {
        playerX.update((x) => Math.min(x + 12, worldWidth - 12))
      },
    },
    left: {
      repeat: true,
      bind: 'left',
      keyDown() {
        playerX.update((x) => Math.max(x - 12, 12))
      },
    },
    up: {
      repeat: true,
      bind: 'up',
      keyDown() {
        playerY.update((y) => Math.max(y - 12, 12))
      },
    },
    down: {
      repeat: true,
      bind: 'down',
      keyDown() {
        playerY.update((y) => Math.min(y + 12, worldHeight - 12))
      },
    },
  })
</script>
