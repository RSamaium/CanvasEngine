<Canvas>
    <Container>
        <!-- Instructions -->
        <Text text="Click the rectangles to shake them!" x={10} y={10} color="#ecf0f1" size="18" fontFamily="Arial" />
        <Text text="Different shake configurations are demonstrated below" x={10} y={35} color="#95a5a6" size="14" fontFamily="Arial" />
    </Container>

    <!-- Basic shake example -->
    <Container x={100} y={100} controls>
        <Text text="Basic Shake" x={0} y={-30} color="#ecf0f1" size="14" fontFamily="Arial" />
        <Sprite 
            image="exp.png"
            width={200}
            height={200}
            borderRadius={8} 
            shake={shakeConfig}
            click={() => shakeTrigger.start()}
        />
    </Container>
</Canvas>

<script>
    import { trigger, signal, on } from 'canvasengine';

    const shakeTrigger = trigger();

    const shakeConfig = {
  trigger: shakeTrigger
};

const controls = signal({
    up: {
        bind: "up",
        keyDown() {
            shakeTrigger.start();
        }
    }
});
</script>

