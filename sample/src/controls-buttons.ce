<Canvas backgroundColor="#2c3e50">
  <Container>
    <!-- Rectangle with controls -->
    <Rect 
      color="#3498db" 
      width={60} 
      height={60} 
      borderRadius={8}
      controls={controls}
      x={x}
      y={y}
    />
    
    <!-- Joystick container below the canvas -->
    <Container y={400} x={200}>
      <Joystick 
        controls={controlsInstance}
        outerColor="#34495e"
        innerColor="#3498db"
      />
    </Container>
    
    <!-- Gamepad buttons A and B (right side) -->
    <Container x={600} y={200}>
      <!-- Button B (top) -->
      <Button 
        text="B"
        shape="circle"
        width={70}
        height={70}
        controls={controlsInstance}
        controlName="buttonB"
        style={{
          backgroundColor: {
            normal: "#e74c3c",
            hover: "#c0392b",
            pressed: "#a93226",
            disabled: "#7f8c8d"
          },
          text: {
            fontSize: 24,
            fontFamily: "Arial Bold",
            color: "#ffffff"
          }
        }}
      />
      
      <!-- Button A (bottom) -->
      <Button 
        text="A"
        shape="circle"
        width={70}
        height={70}
        y={90}
        controls={controlsInstance}
        controlName="buttonA"
        style={{
          backgroundColor: {
            normal: "#2ecc71",
            hover: "#27ae60",
            pressed: "#229954",
            disabled: "#7f8c8d"
          },
          text: {
            fontSize: 24,
            fontFamily: "Arial Bold",
            color: "#ffffff"
          }
        }}
      />
    </Container>
    
    <!-- Instructions -->
    <Text 
      text="Use the joystick below to move the rectangle, or use arrow keys. Click buttons A/B or press Space/Enter"
      x={10}
      y={10}
      color="#ecf0f1"
      size="14"
      fontFamily="Arial"
    />
    
    <!-- Action feedback text -->
    <Text 
      text={actionText}
      x={10}
      y={30}
      color="#f39c12"
      size="16"
      fontFamily="Arial Bold"
    />
  </Container>
</Canvas>

<script>
  import { signal, mount } from "canvasengine"
  // Rectangle position
  const x = signal(200);
  const y = signal(200);
  
  // Movement speed
  const speed = signal(10);
  
  // Action feedback text
  const actionText = signal("");

  // Controls configuration with joystick integration
  const controls = signal({
    left: {
      repeat: true,
      bind: "left",
      keyDown() {
        x.update((x) => Math.max(0, x - speed()));
      },
    },
    right: {
      repeat: true,
      bind: "right",
      keyDown() {
        x.update((x) => x + speed());
      },
    },
    up: {
      repeat: true,
      bind: "up",
      keyDown() {
        y.update((y) => Math.max(0, y - speed()));
      },
    },
    down: {
      repeat: true,
      bind: "down",
      keyDown() {
        y.update((y) => y + speed());
      },
    },
    // Button A action (green button)
    buttonA: {
      bind: ["space", "enter"],
      keyDown() {
        actionText.set("Button A pressed! (Jump/Action)");
        // Add your action logic here (e.g., jump, interact)
        setTimeout(() => {
          actionText.set("");
        }, 1000);
      },
    },
    // Button B action (red button)
    buttonB: {
      bind: ["shift", "x"],
      keyDown() {
        actionText.set("Button B pressed! (Cancel/Secondary)");
        // Add your action logic here (e.g., cancel, secondary action)
        setTimeout(() => {
          actionText.set("");
        }, 1000);
      },
    },
    // Joystick configuration - automatically handles joystick events
    // Uses default direction mapping
    joystick: {
      enabled: true,
      moveInterval: 50,
      threshold: 0.1
    }
  });

  // Store the controls directive instance to pass to the Joystick
  const controlsInstance = signal(null);

  // Get the controls directive from the Rect element
  mount((element) => {
    // Find the Rect element with controls directive
    function findElementWithControls(el) {
      if (el.directives && el.directives.controls) {
        return el;
      }
      if (el.props && el.props.children) {
        for (const child of el.props.children) {
          if (child) {
            const found = findElementWithControls(child);
            if (found) return found;
          }
        }
      }
      return null;
    }

    const rectElement = findElementWithControls(element);
    if (rectElement && rectElement.directives.controls) {
      controlsInstance.set(rectElement.directives.controls);
    }
  });
</script>

