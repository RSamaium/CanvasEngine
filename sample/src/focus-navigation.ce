<Canvas backgroundColor="#2c3e50">
  <Container x={400} y={300}>
    <Text 
      text="Focus Navigation Example" 
      x={0} 
      y={-250} 
      style={{ fontSize: 32, fill: "#ecf0f1" }}
    />
    
    <Text 
      text="Use Up/Down arrows or gamepad to navigate" 
      x={0} 
      y={-200} 
      style={{ fontSize: 16, fill: "#bdc3c7" }}
    />
    
    <Text 
      text="Press Space/Enter to select" 
      x={0} 
      y={-170} 
      style={{ fontSize: 16, fill: "#bdc3c7" }}
    />

    <Viewport screenHeight={300} worldWidth={2000} worldHeight={8000} clamp={ {direction: 'all'} }>
      <FocusContainer 
      tabindex={selectedIndex} 
      controls={controls}
      onFocusChange={onFocusChange}
    >
      <Container>
        <Rect
        width={320}
        height={80}
        x={0}
        y={selectedIndex * 80}
        color="#ffffff"
        alpha={0.2}
        viewportFollow={true}
      />
        @for (item of items) {
          <Container y={item.id * 80}  tabindex={item.id}>
            <Rect
             
              width={300}
              height={60}
              x={0}
              y={0}
              color={item.color}
              alpha={0.5}
            />
            <Text
              text={item.label}
              x={0}
              y={0}
              style={{ fontSize: 24, fill: "#ffffff" }}
            />
          
               
              
          </Container>
        }
      </Container>
    </FocusContainer>
    </Viewport>
  </Container>
</Canvas>

<script>
    import { signal, computed, useFocusChange, mount, effect } from "canvasengine";

    const selectedIndex = signal(0);

    const onFocusChange = (index, element) => {
      console.log('Focus changed to index:', index, element);
    }

    const items100 = new Array(20).fill(0).map((_, index) => ({ id: index, label: `Item ${index + 1}` }));

    const items = signal(items100);
  
    const controls = signal({
      up: {
        repeat: true,
        bind: "up",
        keyDown() {
          console.log("Up pressed");
        }
      },
      down: {
        repeat: true,
        bind: "down",
        keyDown() {
          console.log("Down pressed");
        }
      },
      action: {
        bind: ["space", "enter"],
        keyDown() {
          console.log("Action pressed on item", selectedIndex());
        }
      },
      gamepad: {
        enabled: true
      }
    });
  </script>
