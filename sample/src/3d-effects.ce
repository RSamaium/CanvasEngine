<Canvas backgroundColor="#0f1420">
  <View3D
    positionType="absolute"
    left={0}
    top={0}
    toneMapping="aces"
    shadowQuality="high"
    background={0x1a2238}
    environment={{ skyColor: 0x40507a, groundColor: 0x1c1a14, intensity: 0.5 }}
    fog={{ type: "linear", color: 0x1a2238, near: 18, far: 40 }}
  >
    <Camera3D position={[0, 5, 11]} lookAt={[0, 1, 0]} orbit={orbitOptions} fps={fpsOptions} />

    <DirectionalLight
      color={0xcfd8ff}
      intensity={1.2}
      rotation={[-0.9, 0.6, 0]}
      castShadow={true}
      shadow={{ cascades: 2, maxDistance: 30, bias: 0.0005 }}
    />

    <!-- Ground -->
    <Mesh3D
      geometry={{ type: "plane", width: 60, height: 60 }}
      material={{ baseColor: 0x3d4a35, roughness: 1 }}
      rotation={[-Math.PI / 2, 0, 0]}
      castShadow={false}
    />

    <!-- Campfire: stones, flames, embers and a warm light -->
    <Group3D position={[0, 0, 0]}>
      @for (stone of stones) {
        <Mesh3D geometry={{ type: "icosahedron", radius: 0.28 }} material={{ baseColor: 0x6b6b6b, roughness: 0.9, flatShading: true }} position={stone} />
      }
      <Particles3D
        position={[0, 0.15, 0]}
        capacity={140}
        emitRate={120}
        life={[0.5, 1]}
        speed={[1.4, 2.2]}
        size={[0.5, 0.8]}
        sizeEnd={[0.05, 0.2]}
        alpha={0.75}
        alphaEnd={0}
        color={0xffd98a}
        colorEnd={0xd12b06}
        drag={1.6}
        shape={{ type: "cone", angle: 12, radius: 0.25 }}
        blendMode="add"
        billboard="cylindrical"
        playing={fireOn}
      />
      <Particles3D
        position={[0, 0.6, 0]}
        capacity={40}
        emitRate={14}
        life={[1.5, 2.5]}
        speed={[0.8, 1.6]}
        size={[0.05, 0.09]}
        color={0xffb347}
        colorEnd={0xff4400}
        alphaEnd={0}
        gravity={[0, 0.4, 0]}
        shape={{ type: "sphere", radius: 0.3 }}
        blendMode="add"
        playing={fireOn}
      />
      <PointLight color={0xff8a3d} intensity={fireIntensity} range={10} position={[0, 1, 0]} castShadow={true} />
    </Group3D>

    <!-- Draggable crates, outlined when hovered -->
    @for (crate of crates) {
      <Mesh3D
        geometry={{ type: "cube", width: 1, height: 1, depth: 1 }}
        material={{ baseColor: 0xa0703c, roughness: 0.8 }}
        position={crate.position}
        outlined={crate.hovered}
        drag3d={{ snap: 0.5 }}
        pointerover={() => crate.hovered.set(true)}
        pointerout={() => crate.hovered.set(false)}
      />
    }

    <!-- 2D hero as a camera-facing sprite, animated from its sprite sheet -->
    <Sprite3D
      image="./characters/hero.png"
      frame={heroFrame}
      position={heroPos}
      anchor={{ x: 0.5, y: 1 }}
      billboardMode="cylindrical"
      alphaMode="mask"
      pixelSize={0.02}
    />

    <!-- Glowing orbs for the bloom -->
    @for (orb of orbs) {
      <Mesh3D
        geometry={{ type: "sphere", radius: 0.25 }}
        material={{ baseColor: orb.color, emissive: { color: orb.color, strength: 3 } }}
        position={orb.position}
        castShadow={false}
      />
    }

    <Bloom threshold={1} intensity={1.2} enabled={bloomOn} />
    <Outline width={0.04} color={0xffffff} />
    <Ssao intensity={1} enabled={ssaoOn} />
  </View3D>

  <Container>
    <Text text="@canvasengine/3d · Sprite3D, particles, effects, shadows, drag" x={16} y={14} color="#ffffff" size={17} />
    <Text text="Drag the crates · keys B: bloom, O: SSAO, F: fire, C: orbit / first person (WASD)" x={16} y={40} color="#b8c2d6" size={13} />
    <Text text={status} x={16} y={62} color="#ffd34d" size={13} />
  </Container>
</Canvas>

<script>
  import { signal, computed, tick } from "canvasengine";
  import {
    View3D, Camera3D, Mesh3D, Group3D, Sprite3D, Particles3D,
    DirectionalLight, PointLight, Bloom, Outline, Ssao,
  } from "@canvasengine/3d";

  const bloomOn = signal(true);
  const ssaoOn = signal(true);
  const fireOn = signal(true);
  const firstPerson = signal(false);
  const fireIntensity = signal(25);

  const orbitOptions = computed(() => (firstPerson() ? false : { enableDamping: true, maxPolarAngle: 1.45, target: { x: 0, y: 1, z: 0 } }));
  const fpsOptions = computed(() => (firstPerson() ? { height: 1.7, moveSpeed: 4 } : false));

  const status = computed(() => {
    const [b, o, f, fp] = [bloomOn(), ssaoOn(), fireOn(), firstPerson()];
    return `bloom ${b ? "on" : "off"} · SSAO ${o ? "on" : "off"} · fire ${f ? "on" : "off"} · camera ${fp ? "first person" : "orbit"}`;
  });

  const stones = Array.from({ length: 8 }, (_, i) => {
    const angle = (i / 8) * Math.PI * 2;
    return [Math.cos(angle) * 0.7, 0.12, Math.sin(angle) * 0.7];
  });

  const crates = [[-3, 0.5, 1], [3, 0.5, 2], [2.5, 0.5, -2.5]].map((position) => ({
    position,
    hovered: signal(false),
  }));

  const orbs = [
    { color: 0x66ccff, position: [-4, 1.2, -3] },
    { color: 0xff66cc, position: [4.5, 1.6, -1] },
  ];

  // hero.png: 3 columns x 4 rows of 96 px cells, rows down / left / right / up
  const heroFrame = signal({ x: 0, y: 0, width: 96, height: 96 });
  const heroPos = signal([0, 0, 3]);
  let walkTime = 0;

  window.addEventListener("keydown", (e) => {
    if (e.code === "KeyB") bloomOn.update((v) => !v);
    if (e.code === "KeyO") ssaoOn.update((v) => !v);
    if (e.code === "KeyF") fireOn.update((v) => !v);
    if (e.code === "KeyC") firstPerson.update((v) => !v);
  });

  tick(({ deltaTime }) => {
    const dt = (deltaTime ?? 16.67) / 1000;
    walkTime += dt;
    // Walk in a circle around the fire, facing the direction of travel
    const angle = walkTime * 0.5;
    heroPos.set([Math.sin(angle) * 3, 0, Math.cos(angle) * 3]);
    const column = [0, 1, 2, 1][Math.floor(walkTime * 6) % 4];
    const row = Math.cos(angle) > 0 ? 2 : 1;
    heroFrame.set({ x: column * 96, y: row * 96, width: 96, height: 96 });
    // Flickering fire light
    fireIntensity.set(fireOn() ? 22 + Math.sin(walkTime * 17) * 3 + Math.sin(walkTime * 7) * 2 : 0);
  });
</script>
