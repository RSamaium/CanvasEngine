<Canvas>
   <Container width="80%" height="100%">
      <Sprite
        sheet={{
          definition,
          playing: "explode",
          params: { direction: "right" },
          onFinish
        }}
        playing={selected}
        loop={true}
        click
      />
    
   </Container>
</Canvas>

<style>
  .red {
    background-color: red;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .fontWeight {
    font-weight: bold;
  }

  .blue {
    background-color: blue;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { signal } from 'canvasengine'
  import Child from './child.ce'

  const test = signal(undefined)
  const selected = signal(true)
  const definition = {
    id: "explosion",
    image: "./exp.png",
    framesWidth: 4,
    framesHeight: 4,
    textures: {
      explode: {
        animations: () => [
          [
            { time: 0, frameX: 0, frameY: 0 },
            { time: 10, frameX: 1, frameY: 0 },
            { time: 20, frameX: 2, frameY: 0 },
            { time: 30, frameX: 3, frameY: 0 }
          ]
        ]
      }
    }
  }

  function onFinish() {
    console.log("DOMSprite animation finished")
  }

  function click() {
    selected.set(!selected())
  }
</script>
