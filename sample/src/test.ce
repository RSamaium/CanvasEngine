
<Canvas>
    <DOMContainer class="container" justifyContent="center">  
      <p>Hello</p>
    </DOMContainer>
</Canvas>

<style scoped>
  p {
    font-size: 24px;
    font-weight: bold;
    color: red;
    margin: 10px;
  }
</style>

<script>
import { signal } from "canvasengine";

const text = {
  gold: signal(0),
}

setInterval(() => {
  text.gold.set(text.gold() + 1);
}, 1000);
</script>