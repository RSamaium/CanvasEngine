<Container x y ref="container" attach={child1} />

<script>
    import { mount, signal, computed } from 'canvasengine'

    const x = signal(5)
    const y = signal(5)
    const { children } = defineProps()
    const index = signal(0)

    const child1 = computed(() => children[index()])

    setTimeout(() => {
        index.set(1)
    }, 1000)
</script>
