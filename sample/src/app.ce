<script>
  import {
    signal,
    animatedSignal,
    mount,
    effect,
    animatedSequence,
  } from "canvasengine";
  import MyViewport from "./viewport.ce";
  import { TiledMap } from "@canvasengine/presets";
  
  let bool = signal(false)
  const opacity = animatedSignal(1, { duration: 500 });

  const click = async () => {
    bool.set(!bool())
  }

  const beforeDestroy = async () => {
    await animatedSequence([
      () => opacity.set(0),
    ])
    console.log("before destroy")
  }

  let map = signal(null)

  fetch('/map/simplemap.tmx').then((res) => res.text()).then((text) => {
    text = text.replace(/source="([^"]+)"/g, 'source="map/$1"')
    map.set(text)
  })
  
</script>


<Canvas antialias={true}>
  <TiledMap map={map} basePath="/map" />  
</Canvas>
