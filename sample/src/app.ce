<script>
  import {
    signal,
    animatedSignal,
    mount,
    effect,
    animatedSequence,
  } from "canvasengine";
  import MyViewport from "./viewport.ce";
  
  let bool = signal(false)

  const click = () => {
    bool.set(!bool())
  }
</script>


<Canvas antialias={true}>
  <Container>
    @if (bool) {
      <Rect width={300} height={300} color="red" click />
    }
    @if (!bool) {
      <Rect width={300} height={300} color="blue" click />
    }
  </Container>
</Canvas>
