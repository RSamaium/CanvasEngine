<Canvas>
    <Container>
        @if (bool) {
            <Container onBeforeDestroy>
              <Container >
                <Rect x y color={color} width={100} height={100} />
                <Rect x={300} y={300} color={color} width={100} height={100}  />
              </Container>
            </Container>
        }
    </Container>
</Canvas>

<script>
  import { signal } from 'canvasengine'

  const x = signal(0)
  const y = signal(0)
  const color = 'red'
  const bool = signal(true)

  setTimeout(() => {
    bool.set(false)
  }, 1000)

  const onBeforeDestroy = async () => {
    console.log('onBeforeDestroy called - starting 3 second wait')
    await new Promise(resolve => setTimeout(resolve, 3000))
    console.log('onBeforeDestroy finished - element should now be destroyed from PixiJS')
  }
</script>