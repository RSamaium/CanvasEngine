
<Canvas>
  <Container  x y>
    <Sprite image="https://pixijs.com/assets/flowerTop.png"  />
  </Container>
</Canvas>

<script>
  import { TiledMap } from '@canvasengine/presets'
  import { signal } from 'canvasengine'
  
  let map = signal({})
  
  const x = signal(0)
  const y = signal(0)

  setInterval(() => {
    x.update(x => x + 1)
    y.update(y => y + 1)
  }, 16)
</script>
      