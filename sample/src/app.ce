<Canvas>
  <Container flexDirection="row" width="100%" height="100%">
      @for (color of colors) {
          <Rect width={100} height={100} color={color} />
      }
  </Container>
</Canvas>

<script>
import { signal, computed, effect } from 'canvasengine'

const colors = signal(['red', 'green', 'blue'])
</script>