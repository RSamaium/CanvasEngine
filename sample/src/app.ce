<script>
  import { signal, animatedSignal, mount, effect, animatedSequence } from "canvasengine";

  const items = signal({
    a: 100,
    b: 200,
    c: 300
  });

  items.set({
    a: 100,
    b: 200,
    c: 300,
    d: 400
  });

  items.observable.subscribe(change => {
    console.log(change);
  });

  setTimeout(() => {
    items().d = 800;
  }, 1000);
</script>

<Canvas width="100%" height="100%" >
  @for ((item, key) of items) {
    <Text text={item} color="red" x={item} />
  }
</Canvas>
