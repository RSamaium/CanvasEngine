<script>
  import { signal, animatedSignal, mount, effect } from "canvasengine";
  import { TiledMap } from "@canvasengine/presets";

  const map = signal('');
  const basePath = 'https://raw.githubusercontent.com/RSamaium/RPG-JS/refs/heads/v4/packages/sample2/main/worlds/maps/'
  
  fetch(basePath + 'map.tmx').then(res => res.text()).then(text => map.set(text));

  const bool= signal(true)
</script>

<Canvas>
  <TiledMap map={map} basePath objectLayer={({name}) => 
    <Container>
      @if (bool) {
        <Text text={name} />
      }
    </Container>
  }>
  </TiledMap>
</Canvas>
