<script>
  import {
    signal,
    animatedSignal,
    mount,
    effect,
    animatedSequence,
  } from "canvasengine";
  import MyViewport from "./viewport.ce";
  
  let bool = signal(false)

  const click = () => {
    bool.set(!bool())
  }
</script>


