<Canvas>
  <Container>
    <Rect x={0} y={0} width={width} height={height} color="red" />
  </Container>
</Canvas>

<script>
  import { signal } from 'canvasengine'

  const width = signal(100)
  const height = signal(100)

  setInterval(() => {
    width.update((w) => w + 1)
    height.update((h) => h + 1)
  }, 1000)
  
</script>
