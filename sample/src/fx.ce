<Canvas backgroundColor="#151922">
  <Container sortableChildren={true}>
    <Text text="Fx preset sample" x={24} y={20} color="#ffffff" size="22" />
    <Text text="Click anywhere to spawn hit sparks" x={24} y={52} color="#b9c0cc" size="14" />

    <Rect
      x={0}
      y={0}
      width={900}
      height={620}
      color="rgba(0,0,0,0)"
      click={spawnAtPointer}
    />

    <Fx name="slashSpark" trigger={slashTrigger} x={210} y={185} zIndex={2} />
    <Fx name="impactBurst" trigger={impactTrigger} x={335} y={185} zIndex={2} />
    <Fx name="healPulse" trigger={healTrigger} x={210} y={315} zIndex={2} />
    <Fx name="levelUp" trigger={levelTrigger} x={335} y={315} zIndex={2} />
    <Fx name="magicBurst" trigger={magicTrigger} x={470} y={250} zIndex={2} />
    <Fx name="dashDust" trigger={dashTrigger} x={470} y={425} zIndex={2} />
    <Fx name="campfire" x={620} y={360} loop zIndex={1} />
    <Fx name="torchFire" x={700} y={360} loop zIndex={1} />
    <Fx name="hitSpark" trigger={hitTrigger} x={sparkX} y={sparkY} zIndex={3} />
    <Fx preset={imageSpark} trigger={imageTrigger} x={770} y={250} zIndex={4} />

    <Text text="slash" x={190} y={225} color="#ffd36d" size="13" />
    <Text text="impact" x={310} y={225} color="#ffd36d" size="13" />
    <Text text="heal" x={190} y={365} color="#9fffc5" size="13" />
    <Text text="level" x={315} y={365} color="#ffe870" size="13" />
    <Text text="magic" x={445} y={305} color="#b970ff" size="13" />
    <Text text="dash dust" x={435} y={462} color="#d9c08a" size="13" />
    <Text text="loops" x={635} y={410} color="#ffd36d" size="13" />
    <Text text="image" x={748} y={305} color="#9fd7ff" size="13" />
  </Container>
</Canvas>

<script>
  import { Fx } from '@canvasengine/presets'
  import { signal, trigger } from 'canvasengine'

  const hitTrigger = trigger()
  const slashTrigger = trigger()
  const impactTrigger = trigger()
  const healTrigger = trigger()
  const levelTrigger = trigger()
  const dashTrigger = trigger()
  const magicTrigger = trigger()
  const imageTrigger = trigger()
  const sparkX = signal(260)
  const sparkY = signal(250)

  const imageSpark = {
    duration: 360,
    emitters: [
      {
        burst: 18,
        angle: [0, 360],
        speed: [80, 220],
        particle: {
          image: 'https://pixijs.com/assets/flowerTop.png',
          lifetime: [360, 720],
          alpha: [0.95, 0],
          scale: [0.18, 0.55],
          rotationSpeed: [-180, 180],
          blendMode: 'add',
          ease: 'outCubic',
        },
      },
    ],
  }

  function spawnAtPointer(event) {
    sparkX.set(event.global.x)
    sparkY.set(event.global.y)
    hitTrigger.start()
  }

  setInterval(() => {
    slashTrigger.start()
    impactTrigger.start()
    healTrigger.start()
    levelTrigger.start()
    dashTrigger.start()
    magicTrigger.start()
  }, 1400)

  setInterval(() => {
    imageTrigger.start()
  }, 1800)
</script>
