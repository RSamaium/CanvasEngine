<Canvas backgroundColor="#0f1220">
  <Container sortableChildren={true}>
    <Viewport worldWidth={2048} worldHeight={2048} clamp={viewportClamp} wheel={true} sortableChildren={true}>
      <Sprite image="./back.png" zIndex={0} pointermove={moveTorch} />

      <SpriteShadows
        lights={shadowLights}
        ambientLight={sun}
        mode={shadowMode}
        maxShadows={3}
        shadowColor="#0b1020"
      />

      @for (npc of npcs) {
        <Sprite image={npc.image} x={npc.x} y={npc.y} anchor={[0.5, 1]} zIndex={npc.y} shadowCaster={casterOptions} />
      }

      <Sprite
        image="./characters/knight.png"
        x={heroX}
        y={heroY}
        anchor={[0.5, 1]}
        zIndex={heroY}
        controls={heroControls}
        viewportFollow={true}
        shadowCaster={casterOptions}
      />

      <Fx name="campfire" x={CAMPFIRE.x} y={CAMPFIRE.y} loop enabled={campfireOn} zIndex={CAMPFIRE.y} />
      <Graphics x={torchX} y={torchY} zIndex={5000} draw={drawTorch} visible={torchOn} />
    </Viewport>

    <Container x={16} y={16} zIndex={100}>
      <Rect x={0} y={0} width={300} height={246} color="#0a0f1a" alpha={0.86} borderRadius={14} border={{ width: 1, color: "#3a4a63" }} />
      <Text text="SPRITE SHADOWS" x={18} y={14} color="#8fa7c1" size={11} fontFamily="Arial" style={{ fontWeight: "700", letterSpacing: 1.6 }} />
      <Text text="Arrows: walk · mouse: move the torch" x={18} y={34} color="#c7d5e5" size={12} fontFamily="Arial" />

      <Rect x={18} y={62} width={264} height={30} color="#16213a" borderRadius={8} click={cycleSun} cursor="pointer" />
      <Text text={sunLabel} x={30} y={70} color="#ffd98b" size={12} fontFamily="Arial" />

      <Rect x={18} y={98} width={264} height={30} color="#16213a" borderRadius={8} click={toggleTorch} cursor="pointer" />
      <Text text={torchLabel} x={30} y={106} color="#ffc070" size={12} fontFamily="Arial" />

      <Rect x={18} y={134} width={264} height={30} color="#16213a" borderRadius={8} click={toggleCampfire} cursor="pointer" />
      <Text text={campfireLabel} x={30} y={142} color="#ff9d5a" size={12} fontFamily="Arial" />

      <Rect x={18} y={170} width={264} height={30} color="#16213a" borderRadius={8} click={toggleMode} cursor="pointer" />
      <Text text={modeLabel} x={30} y={178} color="#b8d4ff" size={12} fontFamily="Arial" />

      <Rect x={18} y={206} width={264} height={30} color="#16213a" borderRadius={8} click={toggleShape} cursor="pointer" />
      <Text text={shapeLabel} x={30} y={214} color="#c9c2ff" size={12} fontFamily="Arial" />
    </Container>
  </Container>
</Canvas>

<script>
  import { computed, signal, tick } from "canvasengine";
  import { Fx, SpriteShadows, formatClock, sunShadowAt } from "@canvasengine/presets";

  const viewportClamp = { direction: "all" };
  const CAMPFIRE = { x: 1030, y: 1250 };

  const npcs = [
    { image: "./characters/villager.png", x: 880, y: 1150 },
    { image: "./characters/merchant.png", x: 1180, y: 1215 },
    { image: "./characters/mage.png", x: 1100, y: 1350 },
    { image: "./characters/cat.png", x: 930, y: 1320 },
  ];

  const silhouette = signal(true);
  const casterOptions = computed(() => ({
    height: 90,
    blur: 3,
    hardness: 0.55,
    perspective: 0.7,
    silhouette: silhouette(),
  }));

  // Hero
  const heroX = signal(1000);
  const heroY = signal(1170);
  const step = 6;
  const move = (dx, dy) => () => {
    heroX.update((x) => Math.min(2000, Math.max(40, x + dx)));
    heroY.update((y) => Math.min(2020, Math.max(120, y + dy)));
  };
  const heroControls = {
    left: { repeat: true, bind: "left", keyDown: move(-step, 0) },
    right: { repeat: true, bind: "right", keyDown: move(step, 0) },
    up: { repeat: true, bind: "up", keyDown: move(0, -step) },
    down: { repeat: true, bind: "down", keyDown: move(0, step) },
  };

  // Sun: animated through the day, fixed at noon, or off
  const SUN_MODES = ["cycle", "noon", "off"];
  const sunMode = signal("cycle");
  const sunHour = signal(9);
  tick(({ deltaTime }) => {
    if (sunMode() !== "cycle") return;
    sunHour.update((hour) => (hour + deltaTime / 1000 * 0.5 > 17.8 ? 6.8 : hour + deltaTime / 1000 * 0.5));
  });
  const sun = computed(() => {
    if (sunMode() === "off") return null;
    return sunShadowAt(sunMode() === "noon" ? 12 : sunHour(), { intensity: 0.85, moonlight: 0 });
  });
  const sunLabel = computed(() =>
    sunMode() === "off" ? "Sun: off" : sunMode() === "noon" ? "Sun: noon (short shadows)" : `Sun: day cycle · ${formatClock(sunHour())}`
  );
  const cycleSun = () => sunMode.set(SUN_MODES[(SUN_MODES.indexOf(sunMode()) + 1) % SUN_MODES.length]);

  // Torch following the mouse
  const torchOn = signal(true);
  const torchX = signal(1180);
  const torchY = signal(1080);
  const moveTorch = (event) => {
    const point = event.getLocalPosition(event.currentTarget);
    torchX.set(point.x);
    torchY.set(point.y);
  };
  const toggleTorch = () => torchOn.update((value) => !value);
  const torchLabel = computed(() => `Torch (follows the mouse): ${torchOn() ? "on" : "off"}`);

  const campfireOn = signal(true);
  const toggleCampfire = () => campfireOn.update((value) => !value);
  const campfireLabel = computed(() => `Campfire: ${campfireOn() ? "on" : "off"}`);

  const shadowLights = computed(() => {
    const lights = [];
    if (torchOn()) lights.push({ x: torchX(), y: torchY(), z: 110, radius: 520, intensity: 1.2 });
    if (campfireOn()) lights.push({ x: CAMPFIRE.x, y: CAMPFIRE.y, z: 60, radius: 420, intensity: 1.1 });
    return lights;
  });

  const shadowMode = signal("multi");
  const toggleMode = () => shadowMode.update((mode) => (mode === "multi" ? "strongest" : "multi"));
  const modeLabel = computed(() =>
    shadowMode() === "multi" ? "Mode: multi (one shadow per light)" : "Mode: strongest light only"
  );

  const toggleShape = () => silhouette.update((value) => !value);
  const shapeLabel = computed(() => `Shape: ${silhouette() ? "projected silhouette" : "soft blob"}`);

  const drawTorch = (graphics) => {
    graphics.clear();
    graphics.circle(0, 0, 26).fill({ color: 0xffc070, alpha: 0.18 });
    graphics.circle(0, 0, 12).fill({ color: 0xffd98b, alpha: 0.5 });
    graphics.circle(0, 0, 5).fill({ color: 0xffffff, alpha: 1 });
  };
</script>
