<Canvas backgroundColor="#0f1220">
  <Viewport
    worldWidth={worldWidth}
    worldHeight={worldHeight}
    sortableChildren={true}
    clamp={viewportClamp}
  >
    <Graphics zIndex={0} draw={drawGround} />

    <NightAmbiant
      spots={nightLights}
      darkness={nightDarkness}
      haze={nightHaze}
    /> 

    <SpriteShadows
      lights={shadowLights}
      ambientLight={ambientShadowLight}
      minInfluence={0.16}
      falloffPower={1.2}
      mode="blend2"
      updateHz={60}
      scanHz={8}
      cullToViewport={true}
      shadowColor="#05070d"
    />

    <Graphics
      x={heroX}
      y={heroY}
      zIndex={20}
      controls={heroControls}
      draw={drawHero}
      shadowCaster={heroShadowCaster}
    />

    <Graphics
      x={enemyX}
      y={enemyY}
      zIndex={18}
      draw={drawEnemy}
      shadowCaster={enemyShadowCaster}
    />

    <Graphics x={torchX} y={torchY} zIndex={30} draw={drawTorch} />
    <Graphics x={crystalX} y={crystalY} zIndex={30} draw={drawCrystalLight} />

    <Text
      x={26}
      y={24}
      zIndex={100}
      text="SpriteShadows demo: move with arrows. Spots bend nearby shadows; ambient moonlight keeps distant sprites grounded."
      style={labelStyle}
    />
  </Viewport>
</Canvas>

<script>
  import { computed, signal, tick } from "canvasengine";
  import { SpriteShadows, NightAmbiant } from "@canvasengine/presets";

  const worldWidth = 2048;
  const worldHeight = 2048;
  const viewportClamp = { direction: "all" };
  const nightDarkness = {
    opacity: 0.68,
    color: "#070914",
  };
  const nightHaze = {
    color: "#12182a",
    radius: 0.44,
    softness: 0.3,
    opacity: 0.28,
  };
  const labelStyle = {
    fill: "#f3f4ff",
    fontSize: 18,
    fontFamily: "Courier New",
  };
  const heroShadowCaster = {
    height: 96,
    alpha: 0.5,
    blur: 4.6,
    gradientPower: 2.4,
    hardness: 0.42,
    footOffset: { x: 0, y: 4 },
    maxLength: 260,
  };
  const enemyShadowCaster = {
    height: 84,
    alpha: 0.42,
    blur: 4.2,
    gradientPower: 2.4,
    hardness: 0.38,
    footOffset: { x: 0, y: 3 },
  };
  const ambientShadowLight = {
    x: -0.18,
    y: -1,
    z: 420,
    intensity: 0.18,
    shadowWeight: 0.75,
  };
  const heroX = signal(620);
  const heroY = signal(540);
  const enemyX = signal(1000);
  const enemyY = signal(700);
  const torchX = signal(760);
  const torchY = signal(430);
  const crystalX = signal(1260);
  const crystalY = signal(760);
  const time = signal(0);

  const moveSpeed = 12;
  const heroControls = signal({
    right: {
      repeat: true,
      bind: "right",
      keyDown() {
        heroX.update((x) => Math.min(x + moveSpeed, worldWidth - 40));
      },
    },
    left: {
      repeat: true,
      bind: "left",
      keyDown() {
        heroX.update((x) => Math.max(x - moveSpeed, 40));
      },
    },
    up: {
      repeat: true,
      bind: "up",
      keyDown() {
        heroY.update((y) => Math.max(y - moveSpeed, 40));
      },
    },
    down: {
      repeat: true,
      bind: "down",
      keyDown() {
        heroY.update((y) => Math.min(y + moveSpeed, worldHeight - 40));
      },
    },
  });

  tick(({ deltaTime }) => {
    time.update((t) => t + deltaTime / 1000);
    const t = time();
    enemyX.set(980 + Math.cos(t * 0.8) * 240);
    enemyY.set(680 + Math.sin(t * 0.65) * 170);
    torchX.set(760 + Math.sin(t * 0.35) * 120);
    torchY.set(430 + Math.cos(t * 0.42) * 60);
  });

  const shadowLights = computed(() => [
    {
      x: torchX(),
      y: torchY(),
      z: 170,
      radius: 420,
      intensity: 1.3,
      shadowWeight: 1.5,
    },
    {
      x: crystalX(),
      y: crystalY(),
      z: 250,
      radius: 520,
      intensity: 0.86,
      shadowWeight: 0.85,
    },
  ]);

  const nightLights = computed(() =>
    shadowLights().map((light, index) => ({
      x: light.x,
      y: light.y,
      radius: light.radius * 0.72,
      intensity: index === 0 ? 1 : 0.78,
      flicker: index === 0,
      flickerSpeed: 14,
      pulse: index === 1,
      pulseSpeed: 1.2,
    }))
  );

  const drawGround = (graphics) => {
    graphics.clear();
    graphics.rect(0, 0, worldWidth, worldHeight);
    graphics.fill({ color: 0x334a2b, alpha: 1 });

    graphics.roundRect(875, 0, 130, 2048, 42);
    graphics.fill({ color: 0x8c7445, alpha: 0.72 });
    graphics.roundRect(360, 850, 1150, 120, 42);
    graphics.fill({ color: 0x8c7445, alpha: 0.7 });
    graphics.roundRect(1220, 360, 660, 120, 42);
    graphics.fill({ color: 0x8c7445, alpha: 0.58 });

    for (let i = 0; i < 22; i++) {
      const x = 90 + ((i * 173) % 1840);
      const y = 140 + ((i * 277) % 1720);
      graphics.ellipse(x, y, 42 + (i % 3) * 12, 18 + (i % 4) * 5);
      graphics.fill({ color: i % 2 ? 0x253f25 : 0x42662e, alpha: 0.35 });
    }
  };

  const drawHero = (graphics) => {
    graphics.clear();
    graphics.ellipse(0, -8, 20, 9);
    graphics.fill({ color: 0x111827, alpha: 0.2 });
    graphics.roundRect(-18, -58, 36, 48, 10);
    graphics.fill({ color: 0x2f80ed, alpha: 1 });
    graphics.circle(0, -66, 15);
    graphics.fill({ color: 0xf2c48d, alpha: 1 });
    graphics.roundRect(-24, -32, 48, 14, 7);
    graphics.fill({ color: 0x1f4f9a, alpha: 1 });
  };

  const drawEnemy = (graphics) => {
    graphics.clear();
    graphics.ellipse(0, -7, 18, 8);
    graphics.fill({ color: 0x111827, alpha: 0.18 });
    graphics.roundRect(-17, -52, 34, 44, 10);
    graphics.fill({ color: 0x9b2d42, alpha: 1 });
    graphics.circle(0, -60, 13);
    graphics.fill({ color: 0xd7a06f, alpha: 1 });
    graphics.circle(-7, -63, 3);
    graphics.circle(7, -63, 3);
    graphics.fill({ color: 0xffe066, alpha: 1 });
  };

  const drawTorch = (graphics) => {
    graphics.clear();
    graphics.circle(0, 0, 8);
    graphics.fill({ color: 0xffcc66, alpha: 1 });
    graphics.circle(0, 0, 20);
    graphics.fill({ color: 0xffcc66, alpha: 0.28 });
  };

  const drawCrystalLight = (graphics) => {
    graphics.clear();
    graphics.circle(0, 0, 10);
    graphics.fill({ color: 0x8fd7ff, alpha: 1 });
    graphics.circle(0, 0, 28);
    graphics.fill({ color: 0x4aa9ff, alpha: 0.22 });
  };
</script>
