<Canvas backgroundColor="#0f1220">
  <Viewport
    worldWidth={worldWidth}
    worldHeight={worldHeight}
    sortableChildren={true}
    clamp={viewportClamp}
  >
    <Sprite image="./back.png" width={worldWidth} height={worldHeight} />

    <NightAmbient
      spots={nightLights}
      darkness={nightDarkness}
      haze={nightHaze}
    />

    <SpriteShadows
      lights={shadowLights}
      mode="blend2"
      updateHz={60}
      scanHz={8}
      cullToViewport={true}
      shadowColor="#05070d"
    />

    <Sprite
      x={heroX}
      y={heroY}
      width={96}
      height={96}
      zIndex={20}
      controls={heroControls}
      sheet={heroSheet}
      shadowCaster={heroShadowCaster}
    />

    <Sprite
      x={enemyX}
      y={enemyY}
      width={84}
      height={84}
      alpha={0.92}
      zIndex={18}
      sheet={enemySheet}
      shadowCaster={enemyShadowCaster}
    />

    <Graphics x={torchX} y={torchY} zIndex={30} draw={drawTorch} />
    <Graphics x={crystalX} y={crystalY} zIndex={30} draw={drawCrystalLight} />

    <Text
      x={26}
      y={24}
      zIndex={100}
      text="SpriteShadows demo: move with arrows. Two lights blend shadow direction; off-screen casters are culled."
      style={labelStyle}
    />
  </Viewport>
</Canvas>

<script>
  import { computed, signal, tick } from "canvasengine";
  import { NightAmbient, SpriteShadows } from "@canvasengine/presets";

  const worldWidth = 2048;
  const worldHeight = 2048;
  const viewportClamp = { direction: "all" };
  const nightDarkness = {
    opacity: 0.68,
    color: "#070914",
  };
  const nightHaze = {
    color: "#12182a",
    radius: 0.44,
    softness: 0.3,
    opacity: 0.28,
  };
  const labelStyle = {
    fill: "#f3f4ff",
    fontSize: 18,
    fontFamily: "Courier New",
  };
  const heroShadowCaster = {
    height: 96,
    alpha: 0.62,
    blur: 3.2,
    gradientPower: 2.4,
    hardness: 1,
    footOffset: { x: 0, y: 4 },
    maxLength: 260,
  };
  const enemyShadowCaster = {
    height: 84,
    alpha: 0.48,
    blur: 3.2,
    gradientPower: 2.4,
    hardness: 0.55,
    footOffset: { x: 0, y: 3 },
  };
  const spritesheetDefinition = {
    id: "exp-shadow-demo",
    image: "./exp.png",
    framesWidth: 4,
    framesHeight: 4,
    textures: {
      loop: {
        animations: () => [
          [
            { time: 0, frameX: 0, frameY: 0, anchor: [0.5, 0.86] },
            { time: 8, frameX: 1, frameY: 0, anchor: [0.5, 0.86] },
            { time: 16, frameX: 2, frameY: 0, anchor: [0.5, 0.86] },
            { time: 24, frameX: 3, frameY: 0, anchor: [0.5, 0.86] },
            { time: 32, frameX: 0, frameY: 1, anchor: [0.5, 0.86] },
            { time: 40, frameX: 1, frameY: 1, anchor: [0.5, 0.86] },
            { time: 48, frameX: 2, frameY: 1, anchor: [0.5, 0.86] },
            { time: 56, frameX: 3, frameY: 1, anchor: [0.5, 0.86] },
            { time: 64, frameX: 0, frameY: 2, anchor: [0.5, 0.86] },
            { time: 72, frameX: 1, frameY: 2, anchor: [0.5, 0.86] },
            { time: 80, frameX: 2, frameY: 2, anchor: [0.5, 0.86] },
            { time: 88, frameX: 3, frameY: 2, anchor: [0.5, 0.86] },
            { time: 96, frameX: 0, frameY: 3, anchor: [0.5, 0.86] },
            { time: 104, frameX: 1, frameY: 3, anchor: [0.5, 0.86] },
            { time: 112, frameX: 2, frameY: 3, anchor: [0.5, 0.86] },
            { time: 120, frameX: 3, frameY: 3, anchor: [0.5, 0.86] },
          ],
        ],
      },
    },
  };
  const heroSheet = {
    definition: spritesheetDefinition,
    playing: "loop",
  };
  const enemySheet = {
    definition: spritesheetDefinition,
    playing: "loop",
  };
  const heroX = signal(620);
  const heroY = signal(540);
  const enemyX = signal(1000);
  const enemyY = signal(700);
  const torchX = signal(760);
  const torchY = signal(430);
  const crystalX = signal(1260);
  const crystalY = signal(760);
  const time = signal(0);

  const moveSpeed = 12;
  const heroControls = signal({
    right: {
      repeat: true,
      bind: "right",
      keyDown() {
        heroX.update((x) => Math.min(x + moveSpeed, worldWidth - 40));
      },
    },
    left: {
      repeat: true,
      bind: "left",
      keyDown() {
        heroX.update((x) => Math.max(x - moveSpeed, 40));
      },
    },
    up: {
      repeat: true,
      bind: "up",
      keyDown() {
        heroY.update((y) => Math.max(y - moveSpeed, 40));
      },
    },
    down: {
      repeat: true,
      bind: "down",
      keyDown() {
        heroY.update((y) => Math.min(y + moveSpeed, worldHeight - 40));
      },
    },
  });

  tick(({ deltaTime }) => {
    time.update((t) => t + deltaTime / 1000);
    const t = time();
    enemyX.set(980 + Math.cos(t * 0.8) * 240);
    enemyY.set(680 + Math.sin(t * 0.65) * 170);
    torchX.set(760 + Math.sin(t * 0.35) * 120);
    torchY.set(430 + Math.cos(t * 0.42) * 60);
  });

  const shadowLights = computed(() => [
    {
      x: torchX(),
      y: torchY(),
      z: 170,
      radius: 420,
      intensity: 1.3,
      shadowWeight: 1.5,
    },
    {
      x: crystalX(),
      y: crystalY(),
      z: 250,
      radius: 520,
      intensity: 0.86,
      shadowWeight: 0.85,
    },
  ]);

  const nightLights = computed(() =>
    shadowLights().map((light, index) => ({
      x: light.x,
      y: light.y,
      radius: light.radius * 0.72,
      intensity: index === 0 ? 1 : 0.78,
      flicker: index === 0,
      flickerSpeed: 14,
      pulse: index === 1,
      pulseSpeed: 1.2,
    }))
  );

  const drawTorch = (graphics) => {
    graphics.clear();
    graphics.circle(0, 0, 8);
    graphics.fill({ color: 0xffcc66, alpha: 1 });
    graphics.circle(0, 0, 20);
    graphics.fill({ color: 0xffcc66, alpha: 0.28 });
  };

  const drawCrystalLight = (graphics) => {
    graphics.clear();
    graphics.circle(0, 0, 10);
    graphics.fill({ color: 0x8fd7ff, alpha: 1 });
    graphics.circle(0, 0, 28);
    graphics.fill({ color: 0x4aa9ff, alpha: 0.22 });
  };
</script>
