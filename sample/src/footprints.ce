<Canvas backgroundColor="#0d1424">
  <Viewport
    worldWidth={worldWidth}
    worldHeight={worldHeight}
    sortableChildren={true}
    clamp={viewportClamp}
  >
    <Graphics zIndex={0} draw={drawTerrain} />

    <Footprints
      profiles={surfaceProfiles}
      defaultSurface="sand"
      updateHz={45}
      maxFootprints={320}
    />

    <SpriteShadows ambientLight={sun} shadowColor="#1a1410" />

    @for (walker of walkers) {
      <Sprite
        image={walker.image}
        x={walker.x}
        y={walker.y}
        anchor={[0.5, 1]}
        zIndex={walker.y}
        footprintCaster={walker.prints}
        shadowCaster={shadowOptions}
      />
    }

    <Sprite
      image="./characters/knight.png"
      x={heroX}
      y={heroY}
      anchor={[0.5, 1]}
      zIndex={heroY}
      viewportFollow={true}
      controls={heroControls}
      footprintCaster={heroFootprintCaster}
      shadowCaster={shadowOptions}
    />

    <Text
      x={26}
      y={24}
      zIndex={100}
      text="Footprints demo: move with arrows. Boots, shoes, bare feet and paws; each terrain keeps prints differently (snow/sand/mud/rock)."
      style={labelStyle}
    />

    <Text
      x={26}
      y={58}
      zIndex={100}
      text={surfaceLabel}
      style={surfaceStyle}
    />
  </Viewport>
</Canvas>

<script>
  import { computed, signal, tick } from "canvasengine";
  import { Footprints, SpriteShadows, sunShadowAt } from "@canvasengine/presets";

  const worldWidth = 2048;
  const worldHeight = 1280;
  const viewportClamp = { direction: "all" };
  const moveSpeed = 10;

  const labelStyle = {
    fill: "#f3f4ff",
    fontSize: 18,
    fontFamily: "Courier New",
    wordWrap: true,
    wordWrapWidth: 980,
  };

  const surfaceStyle = {
    fill: "#dfe8ff",
    fontSize: 16,
    fontFamily: "Courier New",
  };

  const heroX = signal(420);
  const heroY = signal(760);

  const zones = [
    {
      name: "mud-pit",
      x1: 860,
      y1: 760,
      x2: 1260,
      y2: 980,
      surface: "mud",
      enabled: true,
      minStepDistance: 13,
      minSpeed: 28,
      alpha: 1.1,
      blur: 0.25,
      size: 0.78,
    },
    {
      name: "rock-platform",
      x1: 1460,
      y1: 840,
      x2: 1880,
      y2: 1100,
      surface: "rock",
      enabled: false,
      minStepDistance: 20,
      minSpeed: 80,
      alpha: 0,
      blur: 0,
      size: 0.76,
    },
    {
      name: "snow-field",
      x1: 0,
      y1: 0,
      x2: worldWidth,
      y2: 560,
      surface: "snow",
      enabled: true,
      minStepDistance: 14,
      minSpeed: 36,
      alpha: 1,
      blur: 0.2,
      size: 0.72,
    },
    {
      name: "sand-dune",
      x1: 0,
      y1: 560,
      x2: worldWidth,
      y2: worldHeight,
      surface: "sand",
      enabled: true,
      minStepDistance: 18,
      minSpeed: 44,
      alpha: 1,
      blur: 0.1,
      size: 0.7,
    },
  ];

  const inZone = (x, y, zone) =>
    x >= zone.x1 && x <= zone.x2 && y >= zone.y1 && y <= zone.y2;

  const fallbackZone = zones[zones.length - 1];

  const zoneAt = (x, y) => {
    for (let i = 0; i < zones.length; i++) {
      const zone = zones[i];
      if (inZone(x, y, zone)) return zone;
    }
    return fallbackZone;
  };

  const currentZone = computed(() => zoneAt(heroX(), heroY()));

  const heroControls = signal({
    right: {
      repeat: true,
      bind: "right",
      keyDown() {
        heroX.update((x) => Math.min(x + moveSpeed, worldWidth - 32));
      },
    },
    left: {
      repeat: true,
      bind: "left",
      keyDown() {
        heroX.update((x) => Math.max(x - moveSpeed, 32));
      },
    },
    up: {
      repeat: true,
      bind: "up",
      keyDown() {
        heroY.update((y) => Math.max(y - moveSpeed, 32));
      },
    },
    down: {
      repeat: true,
      bind: "down",
      keyDown() {
        heroY.update((y) => Math.min(y + moveSpeed, worldHeight - 32));
      },
    },
  });

  const heroFootprintCaster = {
    enabled: () => currentZone().enabled,
    surface: () => currentZone().surface,
    minStepDistance: () => currentZone().minStepDistance,
    minSpeed: () => currentZone().minSpeed,
    alpha: () => currentZone().alpha,
    blur: () => currentZone().blur,
    size: () => currentZone().size,
    stepIntervalMs: 70,
    leftOffset: { x: -8, y: -2 },
    rightOffset: { x: 8, y: -2 },
    print: "boot",
    jitter: 6,
  };

  const sun = sunShadowAt(10.5, { intensity: 0.8 });
  const shadowOptions = { height: 90, blur: 3, hardness: 0.55 };

  // Companions walking loops across the terrains, each with its own prints
  const ellipsePath = (cx, cy, rx, ry, speed, phase) => (t) => [
    cx + Math.cos(t * speed + phase) * rx,
    cy + Math.sin(t * speed + phase) * ry,
  ];
  const companionDefs = [
    { image: "./characters/cat.png", print: "paw", size: 0.55, gap: 10, path: ellipsePath(700, 330, 260, 120, 0.45, 0) },
    { image: "./characters/mage.png", print: "bare", size: 0.8, gap: 7, path: ellipsePath(560, 980, 220, 110, 0.32, 1.5) },
    { image: "./characters/villager.png", print: "shoe", size: 0.75, gap: 7, path: ellipsePath(1060, 870, 150, 70, 0.4, 3) },
  ];
  const walkers = companionDefs.map((def) => {
    const [x, y] = def.path(0);
    const walker = { image: def.image, x: signal(x), y: signal(y) };
    const zone = computed(() => zoneAt(walker.x(), walker.y()));
    walker.prints = {
      enabled: () => zone().enabled,
      surface: () => zone().surface,
      alpha: () => zone().alpha,
      print: def.print,
      size: def.size,
      minStepDistance: 12,
      minSpeed: 10,
      leftOffset: { x: -def.gap, y: -2 },
      rightOffset: { x: def.gap, y: -2 },
    };
    return walker;
  });
  let elapsed = 0;
  tick(({ deltaTime }) => {
    elapsed += Math.min(deltaTime, 100) / 1000;
    companionDefs.forEach((def, index) => {
      const [x, y] = def.path(elapsed);
      walkers[index].x.set(x);
      walkers[index].y.set(y);
    });
  });

  const surfaceLabel = computed(() => {
    const zone = currentZone();
    const mode = zone.enabled ? "footprints ON" : "footprints OFF";
    return `Zone: ${zone.name} | surface: ${zone.surface} | ${mode} | x=${Math.round(heroX())}, y=${Math.round(heroY())}`;
  });

  const surfaceProfiles = {
    sand: {
      tint: "#7f5d34",
      startAlpha: 0.5,
      endAlpha: 0,
      lifetimeMs: 3200,
      blurStart: 0.35,
      blurEnd: 1.6,
      erosionStart: 0.62,
      blendMode: "multiply",
      depth: 0.58,
      rimStrength: 0.12,
    },
    snow: {
      tint: "#889db6",
      startAlpha: 0.4,
      endAlpha: 0,
      lifetimeMs: 4200,
      blurStart: 0.62,
      blurEnd: 2.35,
      erosionStart: 0.43,
      blendMode: "multiply",
      depth: 0.74,
      rimStrength: 0.3,
    },
    mud: {
      tint: "#4e3421",
      startAlpha: 0.42,
      endAlpha: 0,
      lifetimeMs: 3000,
      blurStart: 0.24,
      blurEnd: 1.1,
      erosionStart: 0.78,
      blendMode: "multiply",
      scale: 1.06,
      depth: 0.88,
      rimStrength: 0.08,
    },
    rock: {
      tint: "#5f646b",
      startAlpha: 0.1,
      endAlpha: 0,
      lifetimeMs: 900,
      blurStart: 0.2,
      blurEnd: 0.5,
      erosionStart: 0.35,
      blendMode: "normal",
      depth: 0.34,
      rimStrength: 0.05,
    },
  };

  const drawTerrain = (graphics) => {
    graphics.clear();

    graphics.rect(0, 0, worldWidth, 560);
    graphics.fill({ color: 0xeaf3fb, alpha: 1 });

    graphics.rect(0, 560, worldWidth, worldHeight - 560);
    graphics.fill({ color: 0xd6b17b, alpha: 1 });

    graphics.rect(860, 760, 400, 220);
    graphics.fill({ color: 0x6e4b2f, alpha: 0.85 });

    graphics.rect(1460, 840, 420, 260);
    graphics.fill({ color: 0x69717b, alpha: 0.9 });

    graphics.rect(0, 552, worldWidth, 16);
    graphics.fill({ color: 0xffffff, alpha: 0.22 });

    for (let i = 0; i < 7; i++) {
      const y = 72 + i * 68;
      graphics.rect(0, y, worldWidth, 2);
      graphics.fill({ color: 0xc8d8e7, alpha: 0.18 });
    }

    for (let i = 0; i < 8; i++) {
      const y = 620 + i * 74;
      graphics.rect(0, y, worldWidth, 2);
      graphics.fill({ color: 0xaf8452, alpha: 0.2 });
    }
  };
</script>
