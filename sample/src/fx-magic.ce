<Canvas backgroundColor="#10131c">
  <Container sortableChildren={true}>
    <Text text="RPG magic FX" x={24} y={16} color="#ffffff" size="22" />
    <Text text={subtitle} x={24} y={46} color="#9aa6b8" size="13" />

    @for (swatch of swatches) {
      <Rect x={swatch.x} y={72} width={86} height={28} color={swatch.fill} borderRadius={7} click={swatch.select} cursor="pointer" />
      <Text text={swatch.label} x={swatch.x + 12} y={79} color="#0c0f16" size={11} fontFamily="Arial" style={{ fontWeight: "700" }} />
    }

    @for (cell of spells) {
      <Container x={cell.x} y={cell.y}>
        <Circle x={0} y={0} radius={3} color="#2b3345" />
        <Text text={cell.name} x={-56} y={46} width={112} color="#8f9bb0" size="11" />
        <Fx name={cell.name} trigger={cell.trigger} color={spellColor} zIndex={2} />
      </Container>
    }

    @for (cell of auras) {
      <Container x={cell.x} y={cell.y}>
        <Circle x={0} y={0} radius={3} color="#2b3345" />
        <Text text={cell.name} x={-56} y={46} width={112} color="#8f9bb0" size="11" />
        <Fx name={cell.name} loop={true} color={spellColor} zIndex={2} />
      </Container>
    }

    <Fx name="magicTrail" x={trailX} y={trailY} loop={true} color={spellColor} zIndex={3} />
  </Container>
</Canvas>

<script>
  import { Fx, MAGIC_FX_PRESETS, AURA_FX_PRESETS, STATUS_FX_PRESETS } from '@canvasengine/presets'
  import { computed, signal, tick, trigger } from 'canvasengine'

  const COLUMNS = 6
  const CELL_W = 128
  const CELL_H = 118
  const ORIGIN_X = 90
  const ORIGIN_Y = 170

  const place = (index, offset = 0) => ({
    x: ORIGIN_X + ((index + offset) % COLUMNS) * CELL_W,
    y: ORIGIN_Y + Math.floor((index + offset) / COLUMNS) * CELL_H,
  })

  const spellNames = Object.keys(MAGIC_FX_PRESETS)
  const spells = spellNames.map((name, index) => ({ name, trigger: trigger(), ...place(index) }))
  const auraNames = [...Object.keys(AURA_FX_PRESETS).filter((name) => !name.endsWith('Trail')), ...Object.keys(STATUS_FX_PRESETS)]
  const auras = auraNames.map((name, index) => ({ name, ...place(index, spells.length) }))

  const spellColor = signal(undefined)
  const colorLabel = signal('original colors')
  const subtitle = computed(() => `One-shot spells, loops and status markers · ${colorLabel()}`)

  const palette = [
    { label: 'ORIGINAL', fill: '#d9dee8', color: undefined },
    { label: 'FIRE', fill: '#ff8a4a', color: '#ff5a1f' },
    { label: 'NATURE', fill: '#7ee07a', color: '#3fd46a' },
    { label: 'ARCANE', fill: '#8fa8ff', color: '#5a7dff' },
    { label: 'VOID', fill: '#c38bff', color: '#9b3dff' },
  ]
  const swatches = palette.map((entry, index) => ({
    ...entry,
    x: 24 + index * 94,
    select: () => {
      spellColor.set(entry.color)
      colorLabel.set(entry.color ? `recolored to ${entry.label.toLowerCase()} (applies to the next casts)` : 'original colors')
    },
  }))

  let castIndex = 0
  setInterval(() => {
    spells[castIndex % spells.length].trigger.start()
    castIndex++
  }, 220)

  const trailX = signal(0)
  const trailY = signal(0)
  let time = 0
  tick(({ deltaTime }) => {
    time += deltaTime / 1000
    trailX.set(ORIGIN_X + 2.5 * CELL_W + Math.cos(time * 1.3) * 300)
    trailY.set(128 + Math.sin(time * 2.6) * 10)
  })
</script>
