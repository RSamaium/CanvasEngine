{
  "compilerOptions": {
    "target": "ES2020",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "Bundler",
    "paths": {
      "canvasengine": ["./packages/core/src/index.ts"],
      "@canvasengine/presets": ["./packages/presets/src/index.ts"]
    },
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "exclude": ["**/dist/**", "node_modules", "docs/**"]
}