<Container>
  <StateKeeper />
  @if (layoutMode) {
    <Container width={1240} flexDirection="row" flexWrap="wrap" gap={4}>
      @for (item of items) {
        <Container width={56} height={56} flexDirection="column">
          <Rect width={24} height={24} color="#4aa3ff" />
          <Text text={item.name} size={10} color="#ffffff" />
          <Rect width={item.hp} height={3} color="#53d769" />
        </Container>
      }
    </Container>
  }
  @else {
    @for (item of items) {
      <Container x={item.x} y={item.y}>
        <Rect width={24} height={24} color="#4aa3ff" />
        <Text text={item.name} y={28} size={10} color="#ffffff" />
        <Rect width={item.hp} height={3} y={-6} color="#53d769" />
      </Container>
    }
  }
  <Container x={1000} y={20} width={260} flexDirection="column" gap={4}>
    @for (row of hudRows) {
      <Text text={row.label} size={12} color="#ffffff" />
    }
  </Container>
</Container>

<script>
  import StateKeeper from "./state-keeper.ce";
  import { items, hudRows, layoutMode } from "./state";
</script>
