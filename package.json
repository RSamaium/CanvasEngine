{
  "name": "canvasengine",
  "description": "A reactive HTML5 Canvas management library built on top of PixiJS",
  "version": "2.0.0-beta.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/vite.js",
      "import": "./dist/compiler/vite.js"
    }
  },
  "scripts": {
    "dev": "cd sample && vite",
    "build": "tsup",
    "watch": "tsup --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "docs:build": "cd docs && npm run build",
    "prepublish": "npm run build"
  },
  "dependencies": {
    "@barvynkoa/particle-emitter": "^0.0.1",
    "@pixi/layers": "^2.1.0",
    "@pixi/lights": "^4.1.0",
    "@pixi/tilemap": "^5.0.1",
    "@rpgjs/tiled": "^4.3.0",
    "@signe/reactive": "^1.0.1",
    "animejs": "^3.2.2",
    "d-path-parser": "^1.0.0",
    "framer-motion": "^11.11.9",
    "howler": "^2.2.4",
    "peggy": "^3.0.2",
    "pixi-filters": "^6.0.5",
    "pixi-viewport": "^5.0.3",
    "pixi.js": "^8.6.4",
    "popmotion": "^11.0.5",
    "revolt-fx": "^1.3.5",
    "rxjs": "^7.8.1",
    "stats.js": "^0.17.0",
    "svg-arc-to-cubic-bezier": "^3.2.0",
    "tinycolor2": "^1.6.0",
    "tsup": "^8.2.4",
    "yoga-layout": "^2.0.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^22.10.2",
    "@types/stats.js": "^0.17.3",
    "acorn": "^8.12.1",
    "canvas": "^2.11.2",
    "dedent": "^1.5.3",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "lightningcss": "^1.28.2",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.4",
    "vitest": "^1.6.0",
    "vitest-webgl-canvas-mock": "^1.1.0"
  },
  "author": "Samuel Ronce",
  "license": "MIT",
  "homepage": "https://canvasengine.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/RSamaium/CanvasEngine.git"
  },
  "bugs": {
    "url": "https://github.com/RSamaium/CanvasEngine/issues"
  },
  "keywords": [
    "canvas",
    "pixijs",
    "reactive",
    "html5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "revolt-fx": {
      "pixi.js": "^8.6.4"
    }
  }
}
