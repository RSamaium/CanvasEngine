{
  "name": "canvasengine-project",
  "description": "A reactive HTML5 Canvas management library built on top of PixiJS",
  "type": "module",
  "scripts": {
    "dev:sample": "cd sample && npm run dev",
    "dev": "pnpm -r --filter=./packages/** --parallel run dev",
    "build": "pnpm -r --filter=./packages/** run build",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "release": "bumpp package.json packages/*/package.json --all",
    "changeset": "changeset",
    "publish:packages": "changeset publish",
    "version:packages": "changeset version",
    "preinstall": "cd docs && npm install"
  },
  "dependencies": {
    "@changesets/cli": "^2.27.10",
    "bumpp": "^9.9.1",
    "howler": "^2.2.4",
    "pixi.js": "^8.6.6",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "dedent": "^1.5.3",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "lightningcss": "^1.28.2",
    "vite": "^5.4.4",
    "vitest": "^2.1.8",
    "vitest-webgl-canvas-mock": "^1.1.0"
  },
  "author": "Samuel Ronce",
  "license": "MIT",
  "homepage": "https://canvasengine.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RSamaium/CanvasEngine.git"
  },
  "bugs": {
    "url": "https://github.com/RSamaium/CanvasEngine/issues"
  },
  "keywords": [
    "canvas",
    "pixijs",
    "reactive",
    "html5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "revolt-fx": {
      "pixi.js": "^8.6.4"
    }
  }
}
