{
  "name": "canvasengine-project",
  "description": "A reactive HTML5 Canvas management library built on top of PixiJS",
  "type": "module",
  "scripts": {
    "dev:sample": "cd sample && npm run dev",
    "dev": "pnpm -r --filter=./packages/** --parallel run dev",
    "build": "pnpm -r --filter=./packages/** run build",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "coverage": "vitest --coverage",
    "bench": "pnpm bench:reactivity && pnpm bench:render",
    "bench:reactivity": "tsx benchmarks/reactivity/index.ts",
    "bench:render": "tsx benchmarks/render/run.ts",
    "bench:compare": "tsx benchmarks/compare.ts",
    "release": "bumpp package.json packages/*/package.json --all",
    "changeset": "changeset",
    "publish:packages": "changeset publish",
    "version:packages": "changeset version",
    "preinstall": "cd docs && npm install"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.0",
    "bumpp": "^11.0.1",
    "howler": "^2.2.4",
    "pixi.js": "^8.19.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.5",
    "dedent": "^1.7.2",
    "eslint": "^10.2.1",
    "jsdom": "^29.1.0",
    "lightningcss": "^1.32.0",
    "playwright": "^1.61.1",
    "tinybench": "2.9.0",
    "tsx": "^4.21.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vitest-webgl-canvas-mock": "^1.1.0"
  },
  "author": "Samuel Ronce",
  "license": "MIT",
  "homepage": "https://canvasengine.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RSamaium/CanvasEngine.git"
  },
  "bugs": {
    "url": "https://github.com/RSamaium/CanvasEngine/issues"
  },
  "keywords": [
    "canvas",
    "pixijs",
    "reactive",
    "html5"
  ],
  "publishConfig": {
    "access": "public"
  }
}
